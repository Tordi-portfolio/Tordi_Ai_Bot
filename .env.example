# ===== COPY THIS FILE TO ".env" AND FILL IN YOUR OWN VALUES =====

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Your public website address (NO trailing slash). Used to build the chat link inside emails.
# It must be reachable by your clients, so "localhost" will only work for testing.
SITE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Africa/Lagos

# --- Company ---
COMPANY_NAME=Tordi Visa LTD
# Admin WhatsApp number in international format, digits only (no + or spaces). Example: 2348012345678
WHATSAPP_NUMBER=2347068848255
# Optional: you get an email whenever the AI qualifies a serious client. Leave blank to disable.
ADMIN_NOTIFY_EMAIL=techwithtordi@gmail.com

# --- Gmail (the company mailbox the AI reads and replies from) ---
GMAIL_ADDRESS=josephgbarabe33@gmail.com
# NOT your normal password. Create a 16-character Google "App password" (see README).
GMAIL_APP_PASSWORD=zbxq lewk nfij iplx

# --- AI (Google Gemini, free tier) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The model with the biggest free daily quota changes over time. Check your limits in Google AI Studio
# and put the model name here (examples: gemini-3.8-flash, gemini-3.8-flash-lite).
AI_MODEL=gemini-3.8-flash
# --- Behaviour ---
# True  = AI sends replies automatically.
# False = AI only writes DRAFTS; you approve them in the admin ("Send selected drafts"). Recommended for the first days.
AUTO_SEND_REPLIES=True
# Chatbot lead score (0-10) needed before the visitor is sent to WhatsApp.
QUALIFY_SCORE=7
# Safety limit: max automatic replies to the same sender in 24 hours (stops email loops).
MAX_REPLIES_PER_SENDER_PER_DAY=3
CHAT_MAX_USER_MESSAGES=60
